**/node_modules/
**/.next/
**/out/
**/build/
**/dist/

# Next.js environment & local settings
**/.env*.local
**/.env.production.local
**/.env.development.local
**/.env.test.local

# Vercel & testing coverage
**/.vercel/
**/coverage/
**/.pnpm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

